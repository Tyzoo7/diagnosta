root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,slnx,resx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true

# Format templates come from translations and change with the UI language,
# so caching them as CompositeFormat (CA1863) does not fit. The speed gain would be negligible.
dotnet_diagnostic.CA1863.severity = none

# Test names like Method_Situation_Expectation read as sentences.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
