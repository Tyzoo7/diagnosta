<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Diagnosta</RootNamespace>
    <Version>0.2.0</Version>
    <!-- Needed for direct calls into Windows (kernel32, DXGI). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Product>Diagnosta – PC Checker</Product>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Only ship the languages we actually translate. -->
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Diagnosta.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Diagnosta.Tests" />
  </ItemGroup>

</Project>
