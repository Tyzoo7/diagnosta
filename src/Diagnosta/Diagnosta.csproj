<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Diagnosta</RootNamespace>
    <Version>0.3.0</Version>
    <!-- Needed for direct calls into Windows (kernel32, DXGI). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Product>Diagnosta – PC Checker</Product>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Only ship the languages we actually translate. -->
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Standalone Windows exe: "dotnet publish -r win-x64 -sc".
    Trimming drops unused parts of .NET (about 75 MB -> 14 MB) and makes the build
    warn about code that would not survive it.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Diagnosta.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Diagnosta.Tests" />
  </ItemGroup>

</Project>
