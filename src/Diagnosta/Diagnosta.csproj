<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Diagnosta</RootNamespace>
    <Version>0.4.0</Version>
    <!-- Needed for direct calls into Windows (kernel32, DXGI). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Product>Diagnosta – PC Checker</Product>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Only ship the languages we actually translate. -->
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Lets the lock file cover the Windows build. The standalone exe is published with
    "-p:PublishSingleFile=true -p:PublishTrimmed=true" (see ci.yml) instead of setting those
    here: they pull in an SDK tool package whose version follows the installed .NET patch,
    which would break the lock file every month.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Diagnosta.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Diagnosta.Tests" />
  </ItemGroup>

</Project>
